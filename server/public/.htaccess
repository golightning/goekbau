# goekbau.de – Apache-Konfiguration (web-security, performance-budget, site-navigation).
# Weiterleitungen alter WordPress-URLs werden in Task 10.4 aus config/redirects.ts generiert und unten eingefügt.

Options -Indexes -MultiViews
DirectoryIndex index.html
ServerSignature Off
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
# web-security „Strikte Endpoint-Schnittstelle“: Requests über 11 MB werden vor PHP abgewiesen
LimitRequestBody 11534336

<IfModule mod_rewrite.c>
  RewriteEngine On

  # PHP-Anwendung, Abhängigkeiten, Konfiguration und Dotfiles sind nie per HTTP erreichbar
  RewriteRule ^_app(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule (^|/)(vendor|config|storage|node_modules)(/|$) - [F,L]
  RewriteRule \.(md|log|lock|json|yml|yaml|ini|sh|bak|sql|dist)$ - [F,L,NC]

  # PHP nur für die drei Endpoints – jede andere .php-Datei existiert nach außen nicht
  RewriteCond %{REQUEST_URI} !^/api/(submit|challenge|stats)\.php$
  RewriteRule \.php$ - [R=404,L,NC]

  # ##REDIRECTS## (generiert in Task 10.4)
</IfModule>

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), xr-spatial-tracking=(), interest-cohort=()"
  # HSTS: Browser beachten den Header nur über HTTPS – lokal (HTTP) ohne Wirkung
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Header-CSP für Direktiven, die per <meta> nicht wirken; die Skript-Hashes setzt scripts/csp-hash.mjs je Seite
  Header always set Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
  Header always set X-Frame-Options "DENY"

  # performance-budget „Caching“: gehashte Assets dauerhaft, HTML bei jedem Aufruf revalidieren
  <FilesMatch "\.(js|css|woff2|png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Ungehashte Dateien in /brand/ und Icons dürfen nicht „immutable“ sein
<If "%{REQUEST_URI} =~ m#^/(brand/|icon|apple-icon|favicon)#">
  Header set Cache-Control "public, max-age=86400"
</If>
