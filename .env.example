# Konfiguration des Formular-Endpoints (server/app). Produktion: als Deploy-Now-Runtime-Secrets hinterlegen,
# niemals echte Werte in diese Datei oder ins Repository schreiben. Lokale Werte stehen in docker-compose.yml.
GOEKBAU_ENV=production
# mind. 32 Zeichen, z. B. `openssl rand -hex 32`; daraus werden getrennte Schlüssel je Zweck abgeleitet
GOEKBAU_SECRET=
GOEKBAU_ALLOWED_ORIGINS=https://www.goekbau.de,https://goekbau.de
# optional: privater Speicher außerhalb des Document Roots (Rate-Limit, Replay-Schutz, Logs)
GOEKBAU_STORAGE_DIR=
GOEKBAU_SMTP_HOST=smtp.ionos.de
GOEKBAU_SMTP_PORT=587
GOEKBAU_SMTP_SECURE=tls
GOEKBAU_SMTP_USER=
GOEKBAU_SMTP_PASS=
GOEKBAU_MAIL_FROM=
GOEKBAU_MAIL_FROM_NAME=Website goekbau.de
GOEKBAU_MAIL_TO_CONTACT=
GOEKBAU_MAIL_TO_APPLICATION=
# Agentur-Adresse für den täglichen synthetischen Zustellungstest
GOEKBAU_MAIL_TO_MONITOR=
GOEKBAU_MONITOR_TOKEN=
# kostenloser API-Key von https://auth.abuse.ch/ (nur Hash-Abfragen)
GOEKBAU_MALWAREBAZAAR_KEY=
